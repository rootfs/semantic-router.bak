[79.264591, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"]
[79.264825, "o", "\r\n\u001b[1;36m  8. No Group Match → No Rate Limit\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[82.266031, "o", "\r\n  \u001b[1;37mUser with no group header — no rule matches → unlimited\u001b[0m"]
[82.266316, "o", "\r\n"]
