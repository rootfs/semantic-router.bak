[37.404466, "o", "  \u001b[1;32mHTTP:\u001b[0m   200\r\n  \u001b[1;37mModel:\u001b[0m  Qwen/Qwen2.5-14B-Instruct\r\n  \u001b[1;37mReply:\u001b[0m  The color of the sky can vary depending on the time of day, weather conditions, and atmospheric conditions\r\n"]
