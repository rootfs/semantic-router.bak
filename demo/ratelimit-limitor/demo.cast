[43.525363, "o", "  \u001b[1;32mHTTP:\u001b[0m   200\r\n  \u001b[1;37mModel:\u001b[0m  Qwen/Qwen2.5-14B-Instruct\r\n  \u001b[1;37mReply:\u001b[0m  Python is a popular programming language.\r\n"]
[43.526178, "o", "  \u001b[1;32m✓\u001b[0m Expected HTTP 200 — correct\r\n"]
[47.527285, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  5. Free Tier — Rate Limit Triggered (4th request)\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[50.528287, "o", "\r\n  \u001b[1;37mRequest 4 — OVER THE LIMIT\u001b[0m\r\n  \u001b[0;33mUser:\u001b[0m   free-demo-670409\r\n  \u001b[0;33mGroups:\u001b[0m free-tier\r\n  \u001b[0;33mPrompt:\u001b[0m This should be blocked\r\n"]
[52.749202, "o", "  \u001b[1;32mHTTP:\u001b[0m   200\r\n  \u001b[1;37mModel:\u001b[0m  Qwen/Qwen2.5-14B-Instruct\r\n  \u001b[1;37mReply:\u001b[0m  I'm sorry, I didn't understand your request. Could you please provide more information or context?\r\n"]
[52.750028, "o", "  \u001b[1;31m✗\u001b[0m Expected HTTP 429, got 200\r\n"]
[56.75113, "o", "\r\n  \u001b[0;90mThe 429 response includes standard rate limit headers:\u001b[0m\r\n  \u001b[0;90m  Retry-After tells the client when to try again\u001b[0m\r\n  \u001b[0;90m  X-RateLimit-Limit / Remaining / Reset for monitoring\u001b[0m\r\n"]
[60.752361, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  6. Premium Tier — Higher Limit (10 RPM)\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
