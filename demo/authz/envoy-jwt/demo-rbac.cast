[0.004988, "o", "\r\n\u001b[1m\u001b[36m\r\n  ╔═══════════════════════════════════════════════════════════════════╗\r\n  ║                                                                   ║"]
[0.005511, "o", "\r\n  ║   vLLM Semantic Router — RBAC User/Group Model Routing Demo       ║\r\n  ║                                                                   ║\r\n  ║   JWT Authentication → Role Bindings → Per-User Model Tiers       ║\r\n  ║                                                                   ║\r\n  ╚═══════════════════════════════════════════════════════════════════╝\r\n\u001b[0m\r\n  \u001b[1mArchitecture:\u001b[0m\r\n\r\n  \u001b[2m┌──────────┐    ┌───────────────────┐    ┌──────────────────┐    ┌──────────────────────┐\u001b[0m\r\n  \u001b[2m│  Client  │ →  │  Envoy :8802      │ →  │  Semantic Router │ ─┬→│  \u001b[0m\u001b[32mAdmin\u001b[0m\u001b[2m vLLM :8100  │\u001b[0m\r\n  \u001b[2m│  + JWT   │    │  jwt_authn        │    │  ext_proc :50053 │  │ │  (admin + premium)   │\u001b[0m\r\n  \u001b[2m│          │    │  claim→headers    │    │  RBAC bindings   │  │ └──────────────────────┘\u001b[0m\r\n  \u001b[2m│          │    │                   │    │                  │  │ ┌──────────────────────┐\u001b[0m\r\n  \u001b[2m│          │    │                   │    │                  │  └→│  \u001b[0m\u001b[33mFree\u001b[0m\u001b[2m  vLLM :8200  │\u001b[0m\r\n  \u001b[2m│          │    │                   │    │                  │    │  (free + default)    │\u001b[0m\r\n  \u001b[2m└──────────┘    └───────────────────┘    └──────────────────┘    └──────────────────────┘\u001b[0m\r\n\r\n  \u001b[1mRBAC Role Bindings (JWT group → role → model tier):\u001b[0m\r\n\r\n  \u001b[1mUser               JWT Group              Role             Tier          \u001b[0m\r\n  \u001b[2m──────────────── ──────────────────── ────────────── ────────────\u001b[0m\r\n  alice              platform-admins        \u001b[32madmin           \u001b[0m \u001b[32mAdmin (:8100) \u001b[0m\r\n  bob                premium-tier           \u001b[36mpremium_user    \u001b[0m \u001b[32mAdmin (:8100) \u001b[0m\r\n  carol              free-tier              \u001b[33mfree_user       \u001b[0m \u001b[33mFree  (:8200) \u001b[0m\r\n  unknown            (none)                 \u001b[31m(no match)      \u001b[0m \u001b[33mFree  (:8200) \u001b[0m\r\n\r\n"]
[4.008337, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[41m\u001b[97m PART 1 \u001b[0m  \u001b[1mJWT Authentication — Envoy validates tokens\u001b[0m\r\n\r\n  Envoy's jwt_authn filter checks RSA256 signature, issuer, audience.\r\n  No JWT → \u001b[31m401\u001b[0m.  Expired JWT → \u001b[31m401\u001b[0m.\r\n\r\n"]
[6.009945, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[46m\u001b[97m TEST 1 \u001b[0m  \u001b[1mNo JWT → Envoy rejects (401)\u001b[0m\r\n\r\n"]
[8.011179, "o", "  \u001b[1m\u001b[33mREQUEST\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ user:   \u001b[1m\u001b[33m(anonymous)\u001b[0m\r\n  │ model:  \u001b[1mMoM\u001b[0m (router picks based on identity)\r\n  │ prompt: \"hello\"\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[9.023444, "o", "  \u001b[1m\u001b[31mRESPONSE — HTTP 401 UNAUTHORIZED\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ Envoy rejected: invalid or missing JWT\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[11.024723, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[46m\u001b[97m TEST 2 \u001b[0m  \u001b[1mExpired JWT → Envoy rejects (401)\u001b[0m\r\n\r\n"]
[13.026795, "o", "  \u001b[1m\u001b[33mREQUEST\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ user:   \u001b[1m\u001b[33mexpired (premium-tier, but token expired)\u001b[0m\r\n  │ model:  \u001b[1mMoM\u001b[0m (router picks based on identity)\r\n  │ prompt: \"hello\"\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[14.039424, "o", "  \u001b[1m\u001b[31mRESPONSE — HTTP 401 UNAUTHORIZED\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ Envoy rejected: invalid or missing JWT\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[16.04063, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[42m\u001b[97m PART 2 \u001b[0m  \u001b[1mRBAC Routing — same prompt, different users, different tiers\u001b[0m\r\n\r\n  All four users send the exact same prompt.\r\n  The router picks the model tier based on \u001b[1mwho they are\u001b[0m, not what they ask.\r\n\r\n"]
[18.042038, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[46m\u001b[97m TEST 3 \u001b[0m  \u001b[1mAlice (admin) → Admin tier (:8100)\u001b[0m\r\n\r\n"]
[20.043859, "o", "  \u001b[1m\u001b[33mREQUEST\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ user:   \u001b[1m\u001b[33malice / platform-admins → admin\u001b[0m\r\n  │ model:  \u001b[1mMoM\u001b[0m (router picks based on identity)\r\n  │ prompt: \"What is the capital of France?\"\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[21.193421, "o", "  \u001b[1m\u001b[32mRESPONSE — HTTP 200\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ id:    \u001b[2mchatcmpl-7b23f58a-1883-4d9d-a49d-51877ea67871\u001b[0m\r\n  │ model: \u001b[1m\u001b[32mQwen/Qwen2.5-14B-Instruct\u001b[0m\r\n  │\r\n  │ \u001b[97mThe capital of France is Paris.\u001b[0m\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[23.194679, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[46m\u001b[97m TEST 4 \u001b[0m  \u001b[1mBob (premium) → Admin tier (:8100)\u001b[0m\r\n\r\n"]
[25.196391, "o", "  \u001b[1m\u001b[33mREQUEST\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ user:   \u001b[1m\u001b[33mbob / premium-tier → premium_user\u001b[0m\r\n  │ model:  \u001b[1mMoM\u001b[0m (router picks based on identity)\r\n  │ prompt: \"What is the capital of France?\"\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[26.350141, "o", "  \u001b[1m\u001b[32mRESPONSE — HTTP 200\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ id:    \u001b[2mchatcmpl-c1a266f8-dece-4d69-828e-9b521f7cba0c\u001b[0m\r\n  │ model: \u001b[1m\u001b[32mQwen/Qwen2.5-14B-Instruct\u001b[0m\r\n  │\r\n  │ \u001b[97mThe capital of France is Paris.\u001b[0m\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[28.351259, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[46m\u001b[97m TEST 5 \u001b[0m  \u001b[1mCarol (free) → Free tier (:8200)\u001b[0m\r\n\r\n"]
[30.352843, "o", "  \u001b[1m\u001b[33mREQUEST\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ user:   \u001b[1m\u001b[33mcarol / free-tier → free_user\u001b[0m\r\n  │ model:  \u001b[1mMoM\u001b[0m (router picks based on identity)\r\n  │ prompt: \"What is the capital of France?\"\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[31.515401, "o", "  \u001b[1m\u001b[32mRESPONSE — HTTP 200\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ id:    \u001b[2mchatcmpl-1a98da01-8d2a-4dce-8892-2568fec66404\u001b[0m\r\n  │ model: \u001b[1m\u001b[32mQwen/Qwen2.5-14B-Instruct\u001b[0m\r\n  │\r\n  │ \u001b[97mThe capital of France is Paris.\u001b[0m\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[33.5167, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[46m\u001b[97m TEST 6 \u001b[0m  \u001b[1mUnknown (no group) → Free tier default (:8200)\u001b[0m\r\n\r\n"]
[35.518628, "o", "  \u001b[1m\u001b[33mREQUEST\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ user:   \u001b[1m\u001b[33munknown / (no groups) → default\u001b[0m\r\n  │ model:  \u001b[1mMoM\u001b[0m (router picks based on identity)\r\n  │ prompt: \"What is the capital of France?\"\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[36.681519, "o", "  \u001b[1m\u001b[32mRESPONSE — HTTP 200\u001b[0m\r\n  ┌─────────────────────────────────────────────────────────────\r\n  │ id:    \u001b[2mchatcmpl-c50d6074-75fe-4af6-b005-952598be0ddb\u001b[0m\r\n  │ model: \u001b[1m\u001b[32mQwen/Qwen2.5-14B-Instruct\u001b[0m\r\n  │\r\n  │ \u001b[97mThe capital of France is Paris.\u001b[0m\r\n  └─────────────────────────────────────────────────────────────\r\n\r\n"]
[38.682997, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[45m\u001b[97m PROOF \u001b[0m  \u001b[1mEnvoy access logs — upstream port proves routing\u001b[0m\r\n\r\n"]
[40.685156, "o", "  \u001b[1mEnvoy access log (jwt_sub → upstream):\u001b[0m\r\n\r\n"]
[40.743749, "o", "    jwt_sub=None       → upstream=None                   status=401  \u001b[33m[Free tier]\u001b[0m\r\n"]
[40.800288, "o", "    jwt_sub=alice      → upstream=127.0.0.1:8100         status=200  \u001b[32m[Admin tier]\u001b[0m\r\n"]
[40.876442, "o", "    jwt_sub=bob        → upstream=127.0.0.1:8100         status=200  \u001b[32m[Admin tier]\u001b[0m\r\n"]
[40.945863, "o", "    jwt_sub=carol      → upstream=127.0.0.1:8200         status=200  \u001b[33m[Free tier]\u001b[0m\r\n"]
[40.946134, "o", "\r\n"]
[42.947977, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[36mSummary — RBAC User/Group Model Routing\u001b[0m\r\n\r\n  \u001b[1mRouting is purely identity-based:\u001b[0m\r\n    Same prompt, different users → different model tiers.\r\n    No keyword analysis, no content inspection.\r\n\r\n  \u001b[1mEnd-to-end flow:\u001b[0m\r\n    \u001b[32m✓\u001b[0m JWT signed with RSA256, validated by Envoy's jwt_authn filter\r\n    \u001b[32m✓\u001b[0m Claims extracted to headers: sub → x-jwt-sub, groups → x-jwt-groups\r\n    \u001b[32m✓\u001b[0m Semantic router reads headers, matches RBAC role_bindings\r\n    \u001b[32m✓\u001b[0m admin/premium → Admin tier (:8100), free/unknown → Free tier (:8200)\r\n    \u001b[32m✓\u001b[0m No JWT or expired JWT → \u001b[31m401 Unauthorized\u001b[0m (never reaches router)\r\n\r\n  \u001b[1mNo Kubernetes. No Authorino. Just:\u001b[0m\r\n    Envoy (jwt_authn + ext_proc) + Semantic Router + vLLM\r\n\r\n  \u001b[2mConfig: config/testing/config.authz-rbac-demo.yaml\u001b[0m\r\n\r\n\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n"]
