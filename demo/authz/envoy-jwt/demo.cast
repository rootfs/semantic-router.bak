[0.004828, "o", "\u001b[1;33m\r\n╔═══════════════════════════════════════════════════════════════╗\r\n║  Standalone Envoy JWT + Semantic Router RBAC Demo            ║\r\n║  No Kubernetes — Single Envoy: jwt_authn + ext_proc          ║\r\n╚═══════════════════════════════════════════════════════════════╝\r\n\u001b[0m\r\n"]
[5.006124, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  1. Architecture\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[8.007324, "o", "\r\n  Client (Authorization: Bearer <JWT>)\r\n    │\r\n    ▼\r\n  Envoy :8802\r\n    ├─ jwt_authn     validate RSA256, check iss/aud, extract claims\r\n    │                 sub → x-jwt-sub    groups → x-jwt-groups\r\n    ├─ ext_proc      call semantic router :50053 (RBAC + model select)\r\n    └─ ORIGINAL_DST  route to vLLM 14B (:8000) or 7B (:8001)\r\n\r\n  No Kubernetes.  No Envoy Gateway.  Just Docker + Go binary.\r\n"]
[13.008516, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"]
[13.008765, "o", "\r\n\u001b[1;36m  2. Running Components\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[16.010051, "o", "\r\n\u001b[1;32m$\u001b[0m docker ps --format 'table {{.Names}}"]
[16.010294, "o", "\t{{.Image}}\t{{.Status}}' | grep -E 'NAME|envoy|vllm'\r\n"]
[17.024713, "o", "NAMES                          IMAGE                             STATUS\r\nenvoy-jwt-standalone           envoyproxy/envoy:v1.33-latest     Up 8 minutes\r\nenvoy-rbac-test                envoyproxy/envoy:v1.31-latest     Up 6 hours\r\nvllm-qwen-7b                   vllm/vllm-openai-rocm:v0.15.0     Up 6 hours\r\nvllm-ar-qwen                   vllm-omni-rocm:latest             Up 32 hours\r\nmodality-router-training       vllm-omni-rocm:latest             Up 47 hours\r\nvllm-sr-grafana                grafana/grafana:11.5.1            Up 5 days\r\nvllm-sr-prometheus             prom/prometheus:v2.53.0           Up 5 days\r\nvllm-sr-jaeger                 jaegertracing/all-in-one:latest   Up 5 days\r\n"]
