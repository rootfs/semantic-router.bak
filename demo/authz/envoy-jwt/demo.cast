[61.27963, "o", "\r\n  \u001b[0;33mBody:\u001b[0m {\"model\":\"auto\", \"messages\":[{\"role\":\"user\",\"content\":\"Analyze REST vs GraphQL. Think step by step.\"}]}\r\n"]
