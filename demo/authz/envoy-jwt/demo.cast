[38.133479, "o", "ALICE   sub=alice       groups=platform-admins               \r\nBOB     sub=bob         groups=premium-tier                  \r\nCAROL   sub=carol       groups=free-tier                     \r\n"]
[43.144914, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  4. RBAC Role Bindings\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[46.146585, "o", "\r\n  Group              Role           Model\r\n  ─────────────────  ─────────────  ────────────────────────\r\n  platform-admins    admin          Qwen 14B + reasoning\r\n  premium-tier       premium_user   14B (complex) / 7B (simple)\r\n  free-tier          free_user      7B only\r\n  (no match)         —              7B (default_model)\r\n"]
[51.147704, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  5. Live Requests — Real JWT Authentication\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
