[0.00602, "o", "\r\n\u001b[1m\u001b[36m\r\n  ╔═══════════════════════════════════════════════════════════════════╗\r\n  ║                                                                   ║\r\n  ║   vLLM Semantic Router — Modality Routing Demo                    ║\r\n  ║                                                                   ║\r\n  ║   Automatic AR / Diffusion / Both routing via signal evaluation   ║\r\n  ║                                                                   ║\r\n  ╚═══════════════════════════════════════════════════════════════════╝\r\n\u001b[0m\r\n  \u001b[1mArchitecture:\u001b[0m\r\n\r\n  \u001b[2m┌──────────┐    ┌───────────┐    ┌──────────────────┐    ┌──────────────────────────┐\u001b[0m\r\n  \u001b[2m│\u001b[0m  Client  \u001b[2m│ →  │\u001b[0m   Envoy   \u001b[2m│ →  │\u001b[0m  Semantic Router \u001b[2m│ ─┬→│\u001b[0m  \u001b[32mAR\u001b[0m   Qwen2.5-14B :8100  \u001b[2m│\u001b[0m\r\n  \u001b[2m│\u001b[0m          \u001b[2m│    │\u001b[0m  :8801    \u001b[2m│    │\u001b[0m  ext_proc :50051 \u001b[2m│  │ │\u001b[0m  (text generation)      \u001b[2m│\u001b[0m\r\n  \u001b[2m│\u001b[0m          \u001b[2m│    │\u001b[0m           \u001b[2m│    │\u001b[0m                  \u001b[2m│  │ └──────────────────────────┘\u001b[0m\r\n  \u001b[2m│\u001b[0m          \u001b[2m│    │\u001b[0m           \u001b[2m│    │\u001b[0m  mmBERT-32K      \u001b[2m│  │ ┌──────────────────────────┐\u001b[0m\r\n  \u001b[2m│\u001b[0m          \u001b[2m│    │\u001b[0m           \u001b[2m│    │\u001b[0m  modality signal \u001b[2m│  └→│\u001b[0m  \u001b[35mDIF\u001b[0m  Qwen-Image   :8091  \u001b[2m│\u001b[0m\r\n  \u001b[2m│\u001b[0m          \u001b[2m│    │\u001b[0m           \u001b[2m│    │\u001b[0m                  \u001b[2m│    │\u001b[0m  (image generation)     \u001b[2m│\u001b[0m\r\n  \u001b[2m└──────────┘    └───────────┘    └──────────────────┘    └──────────────────────────┘\u001b[0m\r\n\r\n  \u001b[1mModality Signals:\u001b[0m\r\n    \u001b[32mAR\u001b[0m   