[40.728661, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[41m\u001b[97m PART 4 \u001b[0m  \u001b[1mMissing Key Rejection — fail-closed per provider\u001b[0m\r\n\r\n  Bob has NO Bedrock key → requesting bedrock endpoint fails at router level.\r\n  Carol has NO Anthropic key → requesting anthropic endpoint fails at router level.\r\n  \u001b[2mExpect: router 200 with error body \"no credential found\" (NOT a provider error)\u001b[0m\r\n\r\n"]
[43.730307, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[1m\u001b[46m\u001b[97m TEST 6 \u001b[0m  \u001b[1mBob → claude-sonnet-4-bedrock (NO Bedrock key — router rejects)\u001b[0m\r\n\r\n"]
