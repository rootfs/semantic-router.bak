{"version": 2, "width": 80, "height": 24, "timestamp": 1771422549, "env": {"SHELL": "/bin/bash", "TERM": "dumb"}, "title": "Kuadrant Limitador — Rate Limiting Demo"}
[0.004242, "o", "\u001b[1;33m\r\n╔═══════════════════════════════════════════════════════════════╗\r\n║  Kuadrant Limitador — Rate Limiting Demo                     ║\r\n║  External gRPC RLS v3 service + Semantic Router ext_proc     ║\r\n╚═══════════════════════════════════════════════════════════════╝\r\n\u001b[0m\r\n"]
[4.005107, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  1. Architecture\u001b[0m\r\n"]
[4.005139, "o", "\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[7.006479, "o", "\r\n  Client (x-jwt-sub / x-jwt-groups headers)\r\n    │\r\n    ▼\r\n  Envoy :8805\r\n"]
[7.00651, "o", "    ├─ ext_proc      call semantic router :50056\r\n    │                   ├─ identity:  x-jwt-sub → user, x-jwt-groups → tier\r\n    │                   ├─ envoy-ratelimit provider:\r\n    │                   │    gRPC → Limitador :8081 (Envoy RLS v3)\r\n"]
[7.006531, "o", "    │                   │    descriptors: {user_id, model, group}\r\n    │                   └─ model selection + routing\r\n"]
[7.006658, "o", "    └─ ORIGINAL_DST  route to vLLM :8100\r\n\r\n  Limitador (quay.io/kuadrant/limitador:v2.3.0)\r\n"]
[7.006673, "o", "    ├─ gRPC RLS v3 on :8081  (rate limit decisions)\r\n    ├─ HTTP API on :8080     (limit management)\r\n    └─ In-memory counters    (no Redis needed for demo)\r\n"]
[12.007754, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  2. Limitador Rate Limit Rules\u001b[0m\r\n"]
[12.007784, "o", "\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[15.008966, "o", "\r\n  \u001b[1;37mLimits file:\u001b[0m demo/ratelimit-limitador/limits.yaml\r\n\r\n\r\n\u001b[1;32m$\u001b[0m cat /data/semantic-router.bak/demo/ratelimit-limitador/limits.yaml\r\n"]
[16.010933, "o", "# Limitador rate limit definitions\r\n# These limits are enforced by Kuadrant Limitador via the Envoy RLS v3 gRPC protocol.\r\n#\r\n# The semantic router sends descriptors:\r\n#   descriptor[0]: { user_id: \"<user>\", model: \"<model>\" }\r\n#   descriptor[1]: { group: \"<group>\" }\r\n#\r\n# Limits are intentionally low for demo visibility.\r\n\r\n# Free-tier: 3 requests per minute (per user)\r\n- namespace: semantic-router\r\n  name: free-tier-rpm\r\n  max_value: 3\r\n  seconds: 60\r\n  conditions:\r\n    - \"descriptors[1].group == 'free-tier'\"\r\n  variables:\r\n    - \"descriptors[0].user_id\"\r\n\r\n# Premium-tier: 10 requests per minute (per user)\r\n- namespace: semantic-router\r\n  name: premium-tier-rpm\r\n  max_value: 10\r\n  seconds: 60\r\n  conditions:\r\n    - \"descriptors[1].group == 'premium-tier'\"\r\n  variables:\r\n    - \"descriptors[0].user_id\"\r\n\r\n# Admin: 500 requests per minute (per user)\r\n- namespace: semantic-router\r\n  name: admin-rpm\r\n  max_value: 500\r\n  seconds: 60\r\n  conditions:\r\n    - \"descriptors[1].group == 'platform-admins'\"\r\n  variables:\r\n    - \"descriptors[0].user_id\"\r\n"]
[20.011915, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  3. Running Components\u001b[0m\r\n"]
[20.012007, "o", "\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[23.013134, "o", "\r\n  Limitador :8081  … "]
[23.036226, "o", "\u001b[1;32mOK\u001b[0m (3 limits loaded)\r\n  vLLM :8100       … "]
[23.053347, "o", "\u001b[1;32mOK\u001b[0m (Qwen/Qwen2.5-14B-Instruct)\r\n  Router :50056    … \u001b[1;32mOK\u001b[0m (envoy-ratelimit provider → Limitador)\r\n  Envoy :8805     … \u001b[1;32mOK\u001b[0m (ext_proc + ORIGINAL_DST)\r\n"]
[26.054227, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  4. Query Limitador HTTP API\u001b[0m\r\n"]
[26.054261, "o", "\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[29.055542, "o", "\r\n\u001b[1;32m$\u001b[0m curl -s http://127.0.0.1:8080/limits/semantic-router | python3 -m json.tool\r\n"]
[30.08116, "o", "[\r\n    {\r\n        \"id\": null,\r\n        \"namespace\": \"semantic-router\",\r\n        \"max_value\": 3,\r\n        \"seconds\": 60,\r\n        \"name\": \"free-tier-rpm\",\r\n        \"conditions\": [\r\n            \"descriptors[1].group == 'free-tier'\"\r\n        ],\r\n        \"variables\": [\r\n            \"descriptors[0].user_id\"\r\n        ]\r\n    },\r\n    {\r\n        \"id\": null,\r\n        \"namespace\": \"semantic-router\",\r\n        \"max_value\": 500,\r\n        \"seconds\": 60,\r\n        \"name\": \"admin-rpm\",\r\n        \"conditions\": [\r\n            \"descriptors[1].group == 'platform-admins'\"\r\n        ],\r\n        \"variables\": [\r\n            \"descriptors[0].user_id\"\r\n        ]\r\n    },\r\n    {\r\n        \"id\": null,\r\n        \"namespace\": \"semantic-router\",\r\n        \"max_value\": 10,\r\n        \"seconds\": 60,\r\n        \"name\": \"premium-tier-rpm\",\r\n        \"conditions\": [\r\n            \"descriptors[1].group == 'premium-tier'\"\r\n        ],\r\n        \"variables\": [\r\n            \"descriptors[0].user_id\"\r\n        ]\r\n    }\r\n]\r\n"]
[34.08235, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  5. Free Tier — Requests Within Limit (3 RPM)\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[37.0834, "o", "\r\n  \u001b[1;37mRequest 1 of 3\u001b[0m\r\n  \u001b[0;33mUser:\u001b[0m   free-demo-674864\r\n  \u001b[0;33mGroups:\u001b[0m free-tier\r\n  \u001b[0;33mPrompt:\u001b[0m What is 2+2?\r\n"]
[39.208296, "o", "  \u001b[1;32mHTTP:\u001b[0m   200\r\n  \u001b[1;37mModel:\u001b[0m  Qwen/Qwen2.5-14B-Instruct\r\n  \u001b[1;37mReply:\u001b[0m  2+2 equals 4.\r\n"]
[39.209145, "o", "  \u001b[1;32m✓\u001b[0m Expected HTTP 200 — correct\r\n"]
[43.210295, "o", "\r\n  \u001b[1;37mRequest 2 of 3\u001b[0m\r\n  \u001b[0;33mUser:\u001b[0m   free-demo-674864\r\n  \u001b[0;33mGroups:\u001b[0m free-tier\r\n  \u001b[0;33mPrompt:\u001b[0m What color is the sky?\r\n"]
[45.431227, "o", "  \u001b[1;32mHTTP:\u001b[0m   200\r\n  \u001b[1;37mModel:\u001b[0m  Qwen/Qwen2.5-14B-Instruct\r\n  \u001b[1;37mReply:\u001b[0m  The color of the sky can vary depending on the time of day, weather conditions, and atmospheric conditions\r\n"]
[45.432233, "o", "  \u001b[1;32m✓\u001b[0m Expected HTTP 200 — correct\r\n"]
[49.43331, "o", "\r\n  \u001b[1;37mRequest 3 of 3 (last allowed)\u001b[0m\r\n  \u001b[0;33mUser:\u001b[0m   free-demo-674864\r\n  \u001b[0;33mGroups:\u001b[0m free-tier\r\n  \u001b[0;33mPrompt:\u001b[0m Name a planet\r\n"]
[51.506287, "o", "  \u001b[1;32mHTTP:\u001b[0m   200\r\n  \u001b[1;37mModel:\u001b[0m  Qwen/Qwen2.5-14B-Instruct\r\n  \u001b[1;37mReply:\u001b[0m  Earth\r\n"]
[51.507116, "o", "  \u001b[1;32m✓\u001b[0m Expected HTTP 200 — correct\r\n"]
[55.508324, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  6. Free Tier — Rate Limit Triggered (4th request)\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[58.509676, "o", "\r\n  \u001b[1;37mRequest 4 — OVER THE LIMIT\u001b[0m\r\n  \u001b[0;33mUser:\u001b[0m   free-demo-674864\r\n  \u001b[0;33mGroups:\u001b[0m free-tier\r\n  \u001b[0;33mPrompt:\u001b[0m This should be blocked by Limitador\r\n"]
[60.546535, "o", "  \u001b[1;31mHTTP:\u001b[0m   429  ← RATE LIMITED by Limitador\r\n  \u001b[1;31mError:\u001b[0m  Rate limit exceeded. Retry after 60 seconds.\r\n  \u001b[1;33mRetry-After:\u001b[0m      60 seconds\r\n  \u001b[1;33mX-RateLimit-Limit:\u001b[0m     0\r\n  \u001b[1;33mX-RateLimit-Remaining:\u001b[0m 0\r\n"]
[60.547419, "o", "  \u001b[1;32m✓\u001b[0m Expected HTTP 429 — correct\r\n"]
[64.5486, "o", "\r\n  \u001b[0;90mLimitador returned OVER_LIMIT via gRPC → router returned 429 to client\u001b[0m\r\n  \u001b[0;90mHeaders include Retry-After and X-RateLimit-* for client-side backoff\u001b[0m\r\n"]
[68.549625, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  7. Premium Tier — Higher Limit (10 RPM)\u001b[0m\r\n"]
[68.549665, "o", "\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[71.550763, "o", "\r\n  \u001b[1;37mSending 5 requests as premium-tier user…\u001b[0m\r\n"]
[73.611851, "o", "  \u001b[1;32m✓\u001b[0m Request 1: HTTP 200\r\n"]
[73.668866, "o", "  \u001b[1;32m✓\u001b[0m Request 2: HTTP 200\r\n"]
[73.723522, "o", "  \u001b[1;32m✓\u001b[0m Request 3: HTTP 200\r\n"]
[73.778541, "o", "  \u001b[1;32m✓\u001b[0m Request 4: HTTP 200\r\n"]
[73.833386, "o", "  \u001b[1;32m✓\u001b[0m Request 5: HTTP 200\r\n\r\n  \u001b[1;32m✓\u001b[0m All 5 premium requests succeeded — Limitador allows 10 RPM for this tier\r\n"]
[77.834474, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  8. Per-User Isolation — Independent Counters in Limitador\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[80.835654, "o", "\r\n  \u001b[1;37mUser A (free-tier): exhaust 3 RPM budget\u001b[0m\r\n"]
[80.892221, "o", "  \u001b[0;90m  User A request 1: HTTP 200\u001b[0m\r\n"]
[80.947327, "o", "  \u001b[0;90m  User A request 2: HTTP 200\u001b[0m\r\n"]
[81.002525, "o", "  \u001b[0;90m  User A request 3: HTTP 200\u001b[0m\r\n"]
[81.008223, "o", "  \u001b[1;32m✓\u001b[0m User A request 4: HTTP 429 — blocked by Limitador\r\n"]
[83.00924, "o", "\r\n  \u001b[1;37mUser B (free-tier): fresh counter, should succeed\u001b[0m\r\n"]
[83.065807, "o", "  \u001b[1;32m✓\u001b[0m User B request 1: HTTP 200 — independent counter in Limitador\r\n"]
[87.066952, "o", "\r\n"]
[87.066989, "o", "\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  9. Limitador Counters (HTTP API)\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[90.067976, "o", "\r\n"]
[90.068131, "o", "  \u001b[1;37mQuerying Limitador for active counters:\u001b[0m\r\n"]
[92.069471, "o", "\r\n\u001b[1;32m$\u001b[0m curl -s http://127.0.0.1:8080/counters/semantic-router | python3 -m json.tool | head -40\r\n"]
[93.092472, "o", "[\r\n    {\r\n        \"limit\": {\r\n            \"id\": null,\r\n            \"namespace\": \"semantic-router\",\r\n            \"max_value\": 10,\r\n            \"seconds\": 60,\r\n            \"name\": \"premium-tier-rpm\",\r\n            \"conditions\": ["]
[93.092495, "o", "\r\n                \"descriptors[1].group == 'premium-tier'\"\r\n            ],\r\n            \"variables\": [\r\n                \"descriptors[0].user_id\"\r\n            ]\r\n        },\r\n        \"set_variables\": {\r\n            \"descriptors[0].user_id\": \"premium-demo-674864\"\r\n        },\r\n        \"remaining\": 5,\r\n        \"expires_in_seconds\": 40\r\n    },"]
[93.092736, "o", "\r\n    {\r\n        \"limit\": {\r\n            \"id\": null,\r\n            \"namespace\": \"semantic-router\",\r\n            \"max_value\": 3,\r\n            \"seconds\": 60,\r\n            \"name\": \"free-tier-rpm\",\r\n            \"conditions\": [\r\n                \"descriptors[1].group == 'free-tier'\"\r\n            ],\r\n            \"variables\": [\r\n                \"descriptors[0].user_id\"\r\n            ]\r\n        },\r\n        \"set_variables\": {\r\n            \"descriptors[0].user_id\": \"free-A-674864\"\r\n        },\r\n        \"remaining\": 0,\r\n        \"expires_in_seconds\": 47\r\n"]
[97.097042, "o", "\r\n\u001b[1;33m"]
[97.097128, "o", "\r\n╔═══════════════════════════════════════════════════════════════╗\r\n║  Demo Complete — Kuadrant Limitador Rate Limiting            ║\r\n║                                                              ║\r\n║  1. Free-tier (3 RPM)    → 3 requests OK, 4th → 429        ║"]
[97.097169, "o", "\r\n║  2. 429 response         → Retry-After + X-RateLimit-*      ║\r\n║  3. Premium (10 RPM)     → 5 requests all OK                ║\r\n║  4. Per-user isolation   → User A blocked, User B OK        ║"]
[97.097268, "o", "\r\n║  5. Counters visible     → Limitador HTTP API on :8080      ║\r\n║                                                              ║\r\n║  Kuadrant Limitador v2.3.0 — Envoy RLS v3 gRPC protocol     ║\r\n║  github.com/Kuadrant/limitador                               ║\r\n╚═══════════════════════════════════════════════════════════════╝\r\n\u001b[0m\r\n"]
