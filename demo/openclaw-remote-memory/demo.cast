[6.019974, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m  2 ─ OpenClaw Configuration\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n\u001b[1;32m▸\u001b[0m The openclaw.json configures LLM provider and remote memory:\r\n\r\n\u001b[1;33m── models (LLM via Envoy → Semantic Router → vLLM) ──\u001b[0m\r\n\u001b[2m$ jq '.models' /data/openclaw-demo/config/openclaw.json\u001b[0m\r\n"]
