[26.058761, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m  5 ─ Test: Vector Store Search (Semantic Router)\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n\u001b[1;32m▸\u001b[0m Searching the vector store directly — query: 'database connection pool'\r\n\r\n\u001b[2m$ curl -s -X POST http://localhost:8080/v1/vector_stores/vs_1dd04336-ab8e-493c-afc8-bcfa5f8cc913/search -H 'Content-Type: application/json' -d '{\"query\": \"database connection pool\", \"max_num_results\": 2}' | jq '.data[] | {filename, score, content: (.content[:120] + \"...\") }'\u001b[0m\r\n"]
