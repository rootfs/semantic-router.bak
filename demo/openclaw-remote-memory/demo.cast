[13.029793, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m  3 ─ Workspace Memory Files\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n\u001b[1;32m▸\u001b[0m These markdown files live in the agent workspace and are synced\r\n\u001b[1;32m▸\u001b[0m to the remote vector store for semantic search:\r\n\r\n\u001b[2m$ ls -la /data/openclaw-demo/workspace/memory/\u001b[0m\r\n"]
