[3.005484, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m  1 ─ Running Containers\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n\u001b[1;32m▸\u001b[0m Four containers power this demo:\r\n\r\n\u001b[2m$ docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' | grep -E 'vllm-qwen|semantic-router|envoy|openclaw'\u001b[0m\r\n"]
