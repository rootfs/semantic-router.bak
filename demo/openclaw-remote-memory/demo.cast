[29.088934, "o", "\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m  6 ─ Test: LLM Inference (Envoy → Semantic Router → vLLM)\u001b[0m\r\n\u001b[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n\u001b[1;32m▸\u001b[0m Chat completion through the full routing chain (port 8801):\r\n\r\n\u001b[2m$ curl -s -X POST http://localhost:8801/v1/chat/completions -H 'Content-Type: application/json' -d '{\"model\": \"Qwen/Qwen2.5-14B-Instruct\", \"messages\": [{\"role\": \"user\", \"content\": \"What is 2+2? Answer in one sentence.\"}], \"max_tokens\": 50}' | jq '{model: .model, content: .choices[0].message.content, tokens: .usage}'\u001b[0m\r\n"]
